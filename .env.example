# WhatsApp (solo dígitos con código de país, p. ej. 51XXXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Google Analytics 4: ID de medición (G-XXXXXXXXXX). Vacío = Analytics apagado.
VITE_GA_MEASUREMENT_ID=
# Por defecto no mide hasta que el visitante acepte (grantAnalyticsConsent en src/utils/analytics.ts). Pon false para medir sin consentimiento previo.
VITE_GA_REQUIRE_CONSENT=true

# Verificación de propiedad (solo el valor de content de la metaetiqueta, no la etiqueta completa).
# Si verificas el dominio por DNS (recomendado en Cloudflare) no hace falta ninguna de las dos.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
